<mvc:View controllerName="sap.capire.app.flightapp.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page id="page"
        title="{i18n>title}">

        <Label text="Welcome to the detail page"></Label>
        <VBox >
            <Label text="Airline: {to_Airline/Name}" />
            <Label text="Connection: {ConnectionID}" />
            <Label text="FlightDate: {FlightDate}" />
            <Label text="Price:" />
            <ObjectNumber number="{
							parts:[{path:'Price'},{path:'CurrencyCode_code'}],
							type: 'sap.ui.model.type.Currency',
							formatOptions: {showMeasure: false}
						}"
                unit="{CurrencyCode_code}" />
        </VBox>
    </Page>
</mvc:View>