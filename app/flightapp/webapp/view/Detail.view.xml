<mvc:View controllerName="sap.capire.app.flightapp.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page id="pgDetail"
        title="{i18n>title}"
        showHeader="true">

        <customHeader>
            <Bar>
                <contentRight>
                    <Button id="edit"
                        text="Edit"
                        enabled="false"
                        press="handleEditPress" />
                    <Button id="btnSaveFlightDetails"
                        text="Save"
                        type="Emphasized"
                        visible="false"
                        press="handleSavePress" />
                    <Button id="cancel"
                        text="Cancel"
                        visible="false"
                        press="handleCancelPress" />
                </contentRight>
            </Bar>
        </customHeader>
    </Page>
</mvc:View>