<core:FragmentDefinition xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">
  <VBox class="sapUiSmallMargin">
    <f:SimpleForm id="FlightDetailChange"
      editable="true"
      layout="ResponsiveGridLayout"
      title="FlightDetail">
      <f:content>
        <VBox >
          <Label text="Airline: {to_Airline/Name}" />
          <Label text="Connection: {ConnectionID}" />
          <Label text="FlightDate: {FlightDate}" />
          <Label text="Price:" />
          <Input value="{Price}"
            description="{CurrencyCode_code}"/>
        </VBox>
      </f:content>
    </f:SimpleForm>
  </VBox>
</core:FragmentDefinition>